# Copy this file to `.env` in the same folder (`backend/.env`).
# Ask hui3 for shared values (MongoDB, Cloudinary, JWT, Spoonacular).
# Never commit `.env` to GitHub.

# MongoDB — local example below; use Atlas connection string if your team shares a cloud DB
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017/fitpal

# JWT — generate your own for solo dev, or use the team-shared secret for group testing
# Example: openssl rand -base64 32
JWT_SECRET_KEY=replace-with-long-random-secret

# Spoonacular — https://spoonacular.com/food-api (free API key from dashboard)
SPOONACULAR_API_KEY=replace-with-spoonacular-api-key

# Cloudinary — Dashboard → API Keys (for profile picture upload)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_KEY=replace-with-api-key
CLOUDINARY_SECRET=replace-with-api-secret

# Optional
NODE_ENV=development
